# SentinelFlow local configuration

# --- Core app ---
DEBUG=false
DOMAINS_ROOT=domains
DEFAULT_DOMAIN_PACK=healthcare-claims

# --- Postgres (pgvector default vector store + future checkpoints) ---
# Used when docker compose postgres is running on port 5433.
# Use postgresql+psycopg (matches settings.py default). The pgvector adapter
# converts to postgresql+asyncpg internally for async LangChain operations.
DATABASE_URL=postgresql+psycopg://sentinelflow:sentinelflow@localhost:5433/sentinelflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=sentinelflow
POSTGRES_DB=sentinelflow

# --- Qdrant (alternative vector store adapter) ---
# Used when docker compose qdrant is running:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Embeddings (required for M3 ingestion and retrieval) ---
# Google Gemini Developer API key (read by Settings as GEMINI_API_KEY)
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# Local SQLite cache for embedding vectors (gitignored under .sentinelflow/)
EMBEDDING_CACHE_PATH=.sentinelflow/embedding_cache.sqlite

# --- Rerankers ---
# Local cross-encoder (default, no API key required; downloads model on first use)
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Hosted comparison arm — requires a separate Voyage API key (200M free tokens on signup)
# https://www.voyageai.com/
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# --- Retrieval defaults ---
VECTOR_STORE_BACKEND=pgvector
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5

# --- MCP server (optional) ---
# JSONL audit log for gate decisions; unset uses default below (gitignored under .sentinelflow/)
# SENTINELFLOW_AUDIT_LOG_PATH=.sentinelflow/audit/gate_decisions.jsonl
